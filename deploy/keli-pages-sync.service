[Unit]
Description=Refresh and publish Keli public hotel snapshots
After=network-online.target hotel-web.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/keli-pages-sync/repo
Environment=GIT_SSH_COMMAND=ssh -i /opt/keli-pages-sync/keli_web_github_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new
ExecStart=/usr/bin/bash /opt/keli-pages-sync/repo/deploy/sync_and_push.sh
